# Resend API key (starts with re_). Used to email new registrations and messages.
RESEND_API_KEY=re_...
# Where registrations and contact messages are sent. Until a domain is verified
# in Resend, this must be the email address of the Resend account.
NOTIFY_EMAIL=you@example.com
EMAIL_FROM=SEYO Academy Website <onboarding@resend.dev>
